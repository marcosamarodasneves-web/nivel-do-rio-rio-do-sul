<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível do Rio • Rio do Sul"
            android:textColor="@color/blue_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/bridge_spinner"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline" />

        <TextView
            android:id="@+id/main_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="--,-- m"
            android:textColor="@color/blue_dark"
            android:textSize="52sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/main_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_green"
                android:text="Carregando"
                android:textColor="@color/green"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/main_trend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_blue"
                android:text="→"
                android:textColor="@color/blue"
                android:textStyle="bold" />
        </LinearLayout>

        <br.com.riodosul.niveldorio.RiverChartView
            android:id="@+id/main_chart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nível das barragens"
            android:textColor="@color/blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/main_dams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Taió --%\nItuporanga --%"
            android:textColor="@color/blue_dark"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp">
            <TextView
                android:id="@+id/main_updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atualizando…"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/main_visits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 -- acessos hoje"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Atualizar agora" />

        <TextView
            android:id="@+id/main_refresh_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Atualização automática: app aberto a cada 5 min • widget até 30 min"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/main_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Fonte: Defesa Civil de Rio do Sul / Defesa Civil SC"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
